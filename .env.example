# =====================================================================
# KODIPAY KENYA RENTAL PAYMENT SYSTEM — ENVIRONMENT VARIABLES TEMPLATE
# Copy to .env for local development or configure in Vercel Project Settings
# =====================================================================

# ---------------------------------------------------------------------
# 1. DATABASE CONFIGURATION (Neon Serverless PostgreSQL)
# ---------------------------------------------------------------------
# Obtain this from your Neon Console (https://console.neon.tech):
# Use the pooled connection string (with ?sslmode=require) for serverless compatibility.
# If omitted in local development, the system automatically falls back to local embedded PostgreSQL.
DATABASE_URL="postgresql://neondb_owner:YOUR_NEON_PASSWORD@ep-sample-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require"

# ---------------------------------------------------------------------
# 2. RUNTIME & HOSTING SETTINGS (Vercel / Node)
# ---------------------------------------------------------------------
NODE_ENV="production"
PORT=3000

# Production application base URL (e.g. https://your-project.vercel.app)
APP_URL="https://your-project.vercel.app"

# Secret key used for signing JWT authentication tokens (Must be at least 32 characters)
JWT_SECRET="generate-a-strong-32-character-random-secret-key-here"

# Designated permanent Super Administrator account email (Auto-promoted on login / migration)
SUPER_ADMIN_EMAIL="joshkingtechnologies@gmail.com"
ADMIN_CLAIM_KEY="optional-secure-one-time-claim-key"

# ---------------------------------------------------------------------
# 4. SAFARICOM M-PESA DARAJA API (Optional Live Integration)
# ---------------------------------------------------------------------
DARAJA_CONSUMER_KEY="your-safaricom-daraja-consumer-key"
DARAJA_CONSUMER_SECRET="your-safaricom-daraja-consumer-secret"
DARAJA_PASSKEY="your-safaricom-daraja-passkey"
DARAJA_SHORTCODE="400200"

# ---------------------------------------------------------------------
# 5. GOOGLE GEMINI AI (Intelligent Notification Drafts)
# ---------------------------------------------------------------------
GEMINI_API_KEY="your-gemini-api-key"
